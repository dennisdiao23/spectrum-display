SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SPECTRUM_ADMIN_SECRET=your-admin-header-secret

# Optional — only used when seeding the first admin in an empty database
ADMIN_EMAIL=admin@spectrumdisplay.com
ADMIN_PASSWORD=ChangeMe!Admin
ADMIN_NAME=Spectrum Admin
PORT=3000

# Contact form — messages go to CONTACT_TO_EMAIL
CONTACT_TO_EMAIL=sales@spectrumdisplay.com
# Option A: Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Spectrum Display <beth.t@example.com>
# Option B: SMTP (Gmail app password, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Dealer form — US address autofill (Google Maps Places / Address Validation enabled key)
# Restrict this key to your domain(s) in Google Cloud Console.
GOOGLE_MAPS_API_KEY=
