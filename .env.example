SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SPECTRUM_ADMIN_SECRET=your-admin-header-secret

# Optional — only used when seeding the first admin in an empty database
ADMIN_EMAIL=admin@spectrumdisplay.com
ADMIN_PASSWORD=ChangeMe!Admin
ADMIN_NAME=Spectrum Admin
PORT=3000

# Contact form — messages go to CONTACT_TO_EMAIL (Resend / SMTP)
CONTACT_TO_EMAIL=sales@spectrumdisplay.com
# Option A: Resend (https://resend.com) — public contact form only
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Spectrum Display <beth.t@example.com>
# Option B: SMTP (Gmail app password, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Company Email (quotes / orders / invoices / POs) — send as each staff Gmail
# Google Cloud → APIs & Services → Credentials → Web OAuth client
# Enable Gmail API. Redirect URIs:
#   https://www.spectrumdisplay.com/api/admin/gmail/callback
#   http://localhost:3000/api/admin/gmail/callback
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
# Optional. Encrypts stored Gmail refresh tokens. Falls back to SPECTRUM_ADMIN_SECRET.
GMAIL_TOKEN_SECRET=

# Dealer form and company address fields — Google Maps Places autocomplete
# Restrict this key to your domain(s) in Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# Public US store (store.spectrumdisplay.com) — Shopify Checkout permalinks only.
# Inventory, dealer nets, and warehouse cost stay on www. Never commit secrets.
SHOPIFY_SHOP=n0eg5t-nw.myshopify.com
# Railway only. Dev Dashboard app → Settings → Client ID + Client secret.
# Company → Website → Store → Sync to Shopify uses these to create products.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
WWW_ORIGIN=https://www.spectrumdisplay.com
STORE_ORIGIN=https://store.spectrumdisplay.com

# Company Copilot + Spectrum AI. Preferred: Settings → Chat / AI (saved key + model).
# These env vars are a fallback. Without a key, Copilot can still draft a PO from low stock and parse CSV.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
COPILOT_MODEL=gpt-4o-mini
COPILOT_GEMINI_MODEL=gemini-2.0-flash

# Optional server override for Spectrum AI / Copilot (Settings → Chat / AI is the product path).
# Never expose this to the browser. Do not paste a real key here.
SPECTRUM_CHAT_AI_KEY=
